# ============================================================
# POLARIS / ASTRAONYX — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi '.env' dan sesuaikan konfigurasinya
# ============================================================

# --- Pengaturan Dasar Bot ---
BOT_NAME="Polaris"
BOT_PREFIX="/"
PORT=3000
JWT_SECRET="ganti_dengan_jwt_secret_rahasia_anda_2026"

# --- Nomor Pemilik Utama (Format: 628xxxxxxxxxx) ---
OWNER_NUMBER=""

# --- Direktori & File Penyimpanan ---
AUTH_DIR="./auth_info"
TMP_DIR="./tmp"
LOG_FILE="./logs/error.log"
WHITELIST_FILE="./database/whitelist.json"
GROUP_SETTINGS_FILE="./database/groupSettings.json"
PRIVATE_SETTINGS_FILE="./database/privateChatSettings.json"
COMMAND_OVERRIDES_FILE="./database/command_overrides.json"
CUSTOM_FEATURES_FILE="./database/custom_features.json"

# --- Batas & Keamanan ---
MAX_FILE_SIZE_MB=500
DEFAULT_2FA_PIN="111111"
SESSION_TIMEOUT_HOURS=24
MAX_LOGIN_ATTEMPTS=5

# --- API Keys Layanan AI (Opsional / Sesuai Kebutuhan) ---
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
GROK_API_KEY=""
DEEPSEEK_API_KEY=""

# --- Pengaturan Broadcast Berita ---
NEWS_BROADCAST_INTERVAL_HOURS=4
NEWS_INCLUDE_THUMBNAILS=true
NEWS_INCLUDE_MEDIA=true
NEWS_MAX_ARTICLES=6

# --- Pengaturan Game & Ekosistem ---
GAMES_ENABLED=true
STARLIUM_LEARNING_ENABLED=true
STARLIUM_MAX_MATCHES=500000

# --- Klaster Multi-Bot ---
CLUSTER_MAX_BOTS_PER_USER=5
CLUSTER_MAX_TOTAL_BOTS=30
CLUSTER_MIN_TIER_LEVEL=9

# --- Alat & Layanan Eksternal ---
TOOLS_WEB_TO_APK_DIR="./tmp/apk_builds"
SPOTIFY_FALLBACK_SERVERS="spotidown,spotifydown,spotifymate,btch"
