# ==============================================================================
# Astraonyx Polaris Sovereign — Production .gitignore
# Strictly protecting credentials, session keys, databases, large models & secrets
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment Variables, Secrets & Private Credentials
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.pfx
*.p12

# WhatsApp Baileys Sessions & User Instances (CRITICAL SECURITY)
auth_info/*
!auth_info/.gitkeep
instances/*
!instances/.gitkeep
**/auth_info/*
!**/auth_info/.gitkeep
**/creds.json
*session*.json

# Live Databases, SQLite DBs & Dynamic State (CRITICAL USER DATA)
database/*.sqlite*
database/*.db*
database/*.json
database/backups/*
!database/backups/.gitkeep
database/hermes_user_configs/*
!database/hermes_user_configs/.gitkeep
!database/.gitkeep
!database/migrations/**
!database/hermes_skills/**
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# Backups & Archives
backups/*
!backups/.gitkeep
*.zip
*.tar.gz
*.bak

# Temporary Files, User Uploads & Media Caches
tmp/*
!tmp/.gitkeep
uploads/*
!uploads/.gitkeep
output/*
!output/.gitkeep
public/artifacts/video_hd/*
!public/artifacts/video_hd/.gitkeep

# Third-party Binaries & Platform Executables (>10MB-50MB)
bin/*
!bin/.gitkeep
sagitarius/backend/bin/*
!sagitarius/backend/bin/.gitkeep
!sagitarius/backend/bin/README_windows.md
*.exe
*.dll
*.so
*.dylib
*.bin
*.param

# Sagitarius AI Models & Heavy Artifacts (>50MB / GitHub Limit)
# Models are downloaded via sagitarius/backend/download_assets.py
sagitarius/backend/models/*.onnx
sagitarius/backend/models/*.bin
sagitarius/backend/models/*.pth
sagitarius/backend/models/*.pt
sagitarius/backend/outputs/*
!sagitarius/backend/outputs/.gitkeep
sagitarius/backend/uploads/*
!sagitarius/backend/uploads/.gitkeep
*.onnx
*.weights

# Python Virtual Environments & Bytecode
**/venv/
**/.venv/
**/env/
**/__pycache__/
*.py[cod]

# Build Outputs & Framework Caches
.next/
**/.next/
dist/
**/dist/
dist-ssr/
vendor/
**/vendor/

# Logs & Diagnostics
logs/*
!logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dev Scratch & Local Dumps
scratch/
.turbo/

# OS & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
